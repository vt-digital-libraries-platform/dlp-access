{
  "compilerOptions": {
    "target": "es6",
    "lib": ["es2015", "dom"],
    "types": ["cypress", "node"],
    "allowJs": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.js", "../cypress.config.js"]
}
